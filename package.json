{
  "name": "controle-financeiro",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node ./node_modules/vite/bin/vite.js --host 192.168.40.67 --port 5173",
    "dev:mobile": "node ./node_modules/vite/bin/vite.js --host 192.168.40.67 --port 2515",
    "server": "node server/src/server.js",
    "server:dev": "node --watch server/src/server.js",
    "build": "node ./node_modules/vite/bin/vite.js build",
    "cap:sync": "node ./node_modules/vite/bin/vite.js build && npx cap sync android",
    "cap:open": "npx cap open android",
    "apk:build": "node ./node_modules/vite/bin/vite.js build && npx cap sync android && cd android && gradlew.bat assembleDebug",
    "db:migrate": "node src/scripts/migrate.js",
    "db:seed": "node src/scripts/migrate.js --seed ./data/export.json",
    "lint": "eslint .",
    "preview": "node ./node_modules/vite/bin/vite.js preview"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/status-bar": "^8.0.3",
    "@emailjs/browser": "^4.4.1",
    "axios": "^1.11.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "express": "^4.21.2",
    "html2canvas": "^1.4.1",
    "jspdf": "^3.0.4",
    "jspdf-autotable": "^5.0.8",
    "mysql2": "^3.14.5",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-icons": "^5.7.0",
    "react-router-dom": "^7.7.1",
    "react-toastify": "^11.0.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.1",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "eslint": "^9.30.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "vite": "^7.0.4"
  }
}
